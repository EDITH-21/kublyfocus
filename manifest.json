{
  "manifest_version": 3,
  "name": "BingeBlocker - Focused YouTube Learning",
  "version": "1.0.0",
  "description": "Transforming YouTube into a productive learning environment by blocking feeds, shorts, comments, and recommendations.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "BingeBlocker",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "utils/constants.js",
        "utils/helpers.js",
        "storage/storage.js",
        "utils/messaging.js",
        "content/focus-mode.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_start"
    }
  ]
}

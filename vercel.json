{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/website/index.html"
    },
    {
      "source": "/install",
      "destination": "/website/install.html"
    },
    {
      "source": "/css/:match*",
      "destination": "/website/css/:match*"
    },
    {
      "source": "/js/:match*",
      "destination": "/website/js/:match*"
    },
    {
      "source": "/assets/:match*",
      "destination": "/website/assets/:match*"
    },
    {
      "source": "/:match*",
      "destination": "/website/:match*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
